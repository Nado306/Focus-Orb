{
  "manifest_version": 3,
  "name": "Focus Orb link",
  "version": "1.4.0",
  "description": "Tells the Focus Orb app which site your tab is on, and turns away blocked sites during focus. Talks to 127.0.0.1 only.",
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_title": "Focus Orb link"
  },
  "background": {
    "service_worker": "background.js"
  }
}
